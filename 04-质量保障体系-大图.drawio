 as="geometry"/></mxCell><mxCell id="n22" value="地基 · 统一框架(平台)&#10;S 级系统 · 微服务基础能力 · 质量数据(质检 / 数仓)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#5B6578;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="552" width="700" height="52" as="geometry"/></mxCell><mxCell id="n23" value="" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#CFD6E0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="612" width="740" height="12" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="e2e" name="端到端流程控制点大图"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n24" value="端到端流程控制点大图 —— 问题分【对外】(业务能直接感知,优先做)与【对内】(内部过程,克制收敛);红色标题为最突出环节" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1A2233;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1520" height="30" as="geometry"/></mxCell><mxCell id="n25" value="0 业务方案(环节缺失,建设中)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2233;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n26" value="建设中:业务方案模板与方法" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF6E7;strokeColor=none;fontColor=#B97A12;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="200" height="40" as="geometry"/></mxCell><mxCell id="n27" value="【对外 · 做得对不对】业务方案没做,价值/规则未与业务确认,是下游多数问题的根源" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEFEE;strokeColor=#F2C7C4;fontColor=#D0453E;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="146" width="200" height="84" as="geometry"/></mxCell><mxCell id="n28" value="李敏" style="text;html=1;fontSize=11;fontColor=#5B6578;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="238" width="200" height="24" as="geometry"/></mxCell><mxCell id="n29" value="1 需求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2233;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n30" value="已有:需求评审" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F0;strokeColor=none;fontColor=#1A8F5C;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="98" width="200" height="34" as="geometry"/></mxCell><mxCell id="n31" value="【对外 · 做得对不对】需求偏差 → 上线后返工/推翻重做;产品场景考虑不足" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEFEE;strokeColor=#F2C7C4;fontColor=#D0453E;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="200" height="78" as="geometry"/></mxCell><mxCell id="n32" value="【对内】需求写不清 → 开发理解偏差、走偏" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=none;fontColor=#5B6578;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="226" width="200" height="56" as="geometry"/></mxCell><mxCell id="n33" value="方向:需求模板化(验收标准/边界场景);AI 辅助另立专项" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=none;fontColor=#2F6FED;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="290" width="200" height="62" as="geometry"/></mxCell><mxCell id="n34" value="2 设计" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2233;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="460" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n35" value="已有:内部设计评审" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F0;strokeColor=none;fontColor=#1A8F5C;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="98" width="200" height="34" as="geometry"/></mxCell><mxCell id="n36" value="【对内】缺整体蓝图,反复改、不可扩展(CSDP/CDD);外显为「做得对不对 / 稳不稳」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=none;fontColor=#5B6578;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="200" height="84" as="geometry"/></mxCell><mxCell id="n37" value="方向:核心产品先补大蓝图,设计评审对照蓝图查扩展性" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=none;fontColor=#2F6FED;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="232" width="200" height="62" as="geometry"/></mxCell><mxCell id="n38" value="3 编码(AI)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2233;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n39" value="已有:Code Review(核心模块)· 自测要求" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F0;strokeColor=none;fontColor=#1A8F5C;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="98" width="200" height="46" as="geometry"/></mxCell><mxCell id="n40" value="【对内】AI 代码量大 CR 看不过来;合作方不懂业务也不问;自测有差距;外显为「系统稳不稳」" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=none;fontColor=#5B6578;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="152" width="200" height="96" as="geometry"/></mxCell><mxCell id="n41" value="方向:分级 CR;自测清单化(方案已讨论)" style="rounded=1;arcSize=8;whiteSpace=w