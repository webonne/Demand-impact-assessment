)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D0453E;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n49" value="已有:发布流程(体验、业务验收)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F0;strokeColor=none;fontColor=#1A8F5C;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="98" width="200" height="40" as="geometry"/></mxCell><mxCell id="n50" value="【对外 · 系统稳不稳 / 体验好不好】发布后影响上下游而不自知,故障被业务先感知;体验问题" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDEFEE;strokeColor=#F2C7C4;fontColor=#D0453E;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="146" width="200" height="92" as="geometry"/></mxCell><mxCell id="n51" value="【对内】影响面识别 / 管控能力缺失" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=none;fontColor=#5B6578;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="246" width="200" height="46" as="geometry"/></mxCell><mxCell id="n52" value="方向:发布前强制影响面分析(上下游依赖盘点),与灰度联动放量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=none;fontColor=#2F6FED;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="200" height="72" as="geometry"/></mxCell><mxCell id="n53" value="6 运维" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2233;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="50" width="200" height="40" as="geometry"/></mxCell><mxCell id="n54" value="已有:工单 / 值班 · 可观测列表" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F0;strokeColor=none;fontColor=#1A8F5C;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex=